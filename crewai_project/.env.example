# Copy to .env and fill in real values. Never commit .env.

# Required by web_researcher / job_researcher tools
SERPER_API_KEY=your_serper_api_key_here

# OpenAI is the default LLM provider for CrewAI agents
OPENAI_API_KEY=your_openai_api_key_here

# Toggle workflows on/off (true/false)
WORKFLOW_AI_RESEARCH=false
WORKFLOW_CREWAI_NEWS=false
WORKFLOW_RELOCATION=false
WORKFLOW_LINKEDIN_JOBS=false