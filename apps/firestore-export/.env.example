# Copy this file to `.env` and fill in the values for your own Firebase project.
# Never commit `.env` (it is already ignored by the repository .gitignore).
#
# Values are available in the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration.

# --- Required Firebase Web API configuration -------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Optional Firebase Web API configuration -------------------------------
FIREBASE_DATABASE_URL=
FIREBASE_MEASUREMENT_ID=

# --- Emulator --------------------------------------------------------------
# USE_EMULATOR=true connects to the Firestore emulator on 127.0.0.1:8080.
# FIRESTORE_EMULATOR_HOST=host:port overrides the address (and also enables
# emulator mode). Leave both empty to use the real Firebase project.
USE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=

# --- Shared Firestore options ----------------------------------------------
# Fail instead of waiting forever when the backend is unreachable.
FIRESTORE_WRITE_TIMEOUT_MS=30000

# --- createNotification.js defaults (all optional) -------------------------
# The target user must come from the first script argument or this variable.
NOTIFICATION_USER_ID=
NOTIFICATION_COLLECTION=notifications
NOTIFICATION_CONTENT=Happy Monday!
NOTIFICATION_CHANNEL_ID=2SE4OLb3BISZgZJ82DIh
NOTIFICATION_TYPE=message
NOTIFICATION_SENDER=users/tu1001-m
NOTIFICATION_SENDER_FIRST_NAME=tu1001-Man
NOTIFICATION_SENDER_LAST_NAME=Last-tu1001
NOTIFICATION_TARGET_USER_FIRST_NAME=tu12-Woman
NOTIFICATION_VIEWED=false

# --- filterRequestsByUserDocumentReference.js defaults ---------------------
# The target user must come from the first script argument or this variable.
FILTER_USER_ID=
