    "sourceCode": "/* ==UserStyle==\n@name           notebooklm.google.com\n@namespace      github.com/openstyles/stylus\n@version        1.0.0\n@description    A new userstyle\n@author         Me\n==/UserStyle== */\n@-moz-document url-prefix(\"https://notebooklm.google.com/\") {\n\n    /* 1. Optimized Grid Container (Using modern CSS :has selector instead of /..) */\n    main:has(.source-panel),\n    [class*=\"workspace\"],\n    [class*=\"main-container\"] {\n        display: grid !important;\n        grid-template-columns: 1fr 1fr 1fr !important;\n        width: 100vw !important;\n        gap: 0 !important; \n    }\n\n    /* 2. Panel Reset */\n    .source-panel,\n    .chat-panel,\n    .studio-panel {\n        width: 100% !important;\n        max-width: 100% !important;\n        min-width: 0 !important;\n        flex: unset !important;\n    }\n\n    /* 3. Refined Text Overflow (Targets titles, leaves body paragraph text alone) */\n    .studio-panel [class*=\"title\"], \n    .studio-panel h1, \n    .studio-panel h2, \n    .studio-panel h3 {\n        overflow: hidden !important;\n        text-overflow: ellipsis !important;\n        white-space: nowrap !important;\n    }\n}",
